# Root environment template for MediKiosk
# Copy this to .env or use service-specific .env files

# --- Backend Configuration ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database & Caching ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medikiosk
REDIS_URL=redis://localhost:6379/0

# --- AI Service Providers (Pluggable) ---
# ASR / TTS (AI4Bharat Bhashini)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# LLM Providers (Provider-Agnostic)
LLM_PROVIDER=gemini # options: gemini, openai, groq, local
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# OCR Service
OCR_ENGINE=paddleocr # options: paddleocr, tesseract, mock

# --- ABDM Sandbox Credentials ---
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
